# 默认忽略，仅放行模板源码、规范、依赖和验收工具。
*
!/.gitignore
!/AGENTS.md
!/README.md
!/main.py
!/requirements.txt
!/requirements/
!/requirements/*.txt

!/app/
!/app/**/
!/app/**/*.py
!/description/
!/description/**/
!/description/**/*.md
!/tools/
!/tools/*.py

# 保留目录结构，运行数据、测试样本及实验结果留在本地。
!/data/
!/data/.gitkeep
!/tests/
!/tests/fixtures/
!/tests/fixtures/.gitkeep
!/tests/tmp/
!/tests/tmp/.gitkeep
!/experiment/
!/experiment/.gitkeep

.env
.env.*
!/.env.example
__pycache__/
*.py[cod]
.venv/
.idea/
.DS_Store
*.log
*.tmp
*.swp
*~
